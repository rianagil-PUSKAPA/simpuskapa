  "scripts": {
    "build": "next build && nest build --path ./tsconfig.server.json",
    "build:next": "next build",
    "analyze": "ANALYZE=true next build",
    "build:nest": "prisma generate && nest build --path ./tsconfig.server.json",
    "start:prod": "node ./dist/server/main.js",
    "start:next-dev": "next dev",
    "start:nest-dev": "nest start --path ./tsconfig.server.json --entryFile server/main.js --watch",
    "start:nest": "prisma generate && node dist-server/server/main.js",
    "start:nest-debug": "nest start --path ./tsconfig.server.json --debug --watch",
    "gen:init": "openapi-generator-cli version-manager set 6.5.0",
    "gen:client": "rm -rf swagger-json && wget https://api.staging.sim.puskapa.org/swagger-json && npx @openapitools/openapi-generator-cli generate -i swagger-json -g typescript-axios -o sdk",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "measure:baseline": "node scripts/measure-baseline.js",
    "measure:compare": "node scripts/compare-metrics.js",
    "measure:full": "npm run test:cov && npm run build && npm run analyze && npm run measure:baseline",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix && npx prettier --write .",
    "deploy:fe": "sh deploy-fe.sh",
    "deploy:be": "sh deploy-be.sh",
    "ssh": "ssh -i simpuskapa.pem simpuskapa@103.150.92.73 -o ServerAliveInterval=10",
    "rebuild:local:database": "sh rebuild-local-api.sh",
    "bump:major": "sh bump.sh major",
    "bump:minor": "sh bump.sh minor",
    "bump:patch": "sh bump.sh patch",
    "deploy:build": "export BUMP=$(gum choose 'major' 'minor' 'patch') && sh deployment/build-artifact.sh $BUMP",
    "deploy:update": "sh deployment/deploy-artifact.sh",
    "make:buckets": "nest build --path ./tsconfig.server.json && node ./dist-server/server/commands/create.bucket.js"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seeder/seed.ts"
  },
  "husky": {
    "hooks": {
      "pre-commit": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix && npx prettier --write ."
    }
  },
