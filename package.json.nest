{
  "name": "simpuskapa",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "next build && nest build --path ./tsconfig.server.json",
    "build:next": "next build",
    "build:nest": "nest build --path ./tsconfig.server.json",
    "start:prod": "node ./dist/server/main.js",
    "start:next-dev": "next dev",
    "start:nest-dev": "nest start --path ./tsconfig.server.json --entryFile server/main.js --watch",
    "start:nest-debug": "nest start --path ./tsconfig.server.json --debug --watch",
    "start:dev": "concurrently \"nest start --path ./tsconfig.server.json --entryFile server/main.js --watch\" \"next dev\"",
    "gen:init": "openapi-generator-cli version-manager set 6.5.0",
    "gen:client": "rm -rf docs-yaml && wget http://localhost:${NEST_PORT}/docs-yaml && npx @openapitools/openapi-generator-cli generate -i docs-yaml -g typescript-axios -o sdk",
    "test": "jest",
    "test:cov": "jest --coverage",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix && npx prettier --write .",
    "deploy:fe": "sh deploy-fe.sh",
    "deploy:be": "sh deploy-be.sh",
    "ssh": "ssh -i simpuskapa.pem simpuskapa@103.150.190.176 -o ServerAliveInterval=10",
    "rebuild:local:database": "sh rebuild-local-api.sh"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seeder/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^9.0.0",
    "@nestjs/core": "^9.3.10",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/swagger": "^6.2.1",
    "@prisma/client": "^4.11.0",
    "@sentry/nextjs": "^7.50.0",
    "@sentry/node": "^7.47.0",
    "@tanstack/react-table": "^8.8.4",
    "@types/bcrypt": "^5.0.0",
    "axios": "^1.3.4",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "classnames": "^2.3.2",
    "concurrently": "^7.6.0",
    "cookies": "^0.8.0",
    "dayjs": "^1.11.7",
    "express": "^4.18.2",
    "gsap": "^3.11.5",
    "jose": "^4.14.1",
    "jsrsasign": "^10.7.0",
    "jsrsasign-util": "^1.0.5",
    "keen-slider": "^6.8.5",
    "multer": "1.4.5-lts.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "sdk": "^0.5.0",
    "typescript-cookie": "^1.0.5",
    "url-parse": "^1.5.10",
    "uuid": "^9.0.0",
    "webpack": "^5.76.2",
    "whatwg-fetch": "^3.6.2",
    "@faker-js/faker": "^7.6.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^7.6.0",
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.3.10",
    "@playwright/test": "^1.31.2",
    "@tailwindcss/forms": "^0.5.3",
    "@trivago/prettier-plugin-sort-imports": "^4.1.1",
    "@types/express": "^4.17.13",
    "@types/jest": "29.2.4",
    "@types/multer": "^1.4.7",
    "@types/node": "18.11.18",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.7.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-tailwindcss": "^3.10.1",
    "install": "^0.13.0",
    "jest": "29.3.1",
    "postcss": "^8.4.21",
    "prettier": "^2.8.6",
    "prettier-plugin-organize-imports": "^3.2.2",
    "prettier-plugin-tailwindcss": "^0.2.5",
    "prisma": "^4.11.0",
    "source-map-support": "^0.5.20",
    "supertest": "^6.3.3",
    "tailwind-scrollbar": "^3.0.0",
    "tailwindcss": "^3.2.7",
    "ts-jest": "29.0.3",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.1",
    "typescript": "^4.7.4",
    "uglify-js": "^3.17.4"
  },
  "jest": {
    "moduleNameMapper": {
      "@server/(.*)": "<rootDir>/server/$1",
      "@/(.*)": "<rootDir>/$1"
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
