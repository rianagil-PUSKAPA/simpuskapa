info:
  title: SIMPUSKAPA API
  description: SIMPUSKAPA API description
  version: '1.0'
  contact: {}
tags:
  - name: identity
    description: ''
  - name: employee
    description: ''
servers: []
components:
  securitySchemes:
    bearer:
      scheme: bearer
      bearerFormat: JWT
      type: http
  schemas:
    User:
      type: object
      properties:
        id:
          type: string
        email:
          type: string
        password:
          type: string
      required:
        - id
        - email
        - password
    PairJWT:
      type: object
      properties:
        auth_token:
          type: string
        refresh_token:
          type: string
      required:
        - auth_token
        - refresh_token
    PairJWTResponse:
      type: object
      properties:
        message:
          type: string
        data:
          $ref: '#/components/schemas/PairJWT'
      required:
        - message
        - data
    HttpBaseResponse:
      type: object
      properties:
        message:
          type: string
        data:
          type: object
      required:
        - message
        - data
    UserListResponse:
      type: object
      properties:
        message:
          type: string
        data:
          type: array
          items:
            $ref: '#/components/schemas/User'
      required:
        - message
        - data
    CreateUserRequest:
      type: object
      properties:
        email:
          type: string
        password:
          type: string
        acl:
          type: array
          items:
            type: string
      required:
        - email
        - password
        - acl
    CreateUserResponseDetail:
      type: object
      properties:
        email:
          type: string
        password:
          type: string
        acl:
          type: array
          items:
            type: string
        id:
          type: string
      required:
        - email
        - password
        - acl
        - id
    CreateUserResponse:
      type: object
      properties:
        message:
          type: string
        data:
          $ref: '#/components/schemas/CreateUserResponseDetail'
      required:
        - message
        - data
    UpdateUserRequest:
      type: object
      properties:
        email:
          type: string
        acl:
          type: array
          items:
            type: string
      required:
        - email
        - acl
    UpdateUserPassword:
      type: object
      properties:
        password:
          type: string
      required:
        - password
    AclKeysResponse:
      type: object
      properties:
        message:
          type: string
        data:
          type: array
          items:
            type: string
      required:
        - message
        - data
    CreateAclTemplateRequest:
      type: object
      properties:
        name:
          type: string
        acl:
          type: array
          items:
            type: string
      required:
        - name
        - acl
    AclTemplate:
      type: object
      properties:
        role_name:
          type: string
        acl:
          type: array
          items:
            type: string
      required:
        - role_name
        - acl
    AclTemplateResponse:
      type: object
      properties:
        message:
          type: string
        data:
          type: array
          items:
            $ref: '#/components/schemas/AclTemplate'
      required:
        - message
        - data
    Employee:
      type: object
      properties:
        id:
          type: string
        staff_id:
          type: string
        user_id:
          type: string
        gender:
          type: string
          enum: &ref_0
            - male
            - female
        full_name:
          type: string
        pob:
          type: string
        dob:
          type: object
        religion:
          type: string
        marital_status:
          type: string
          enum: &ref_1
            - maried
            - not_maried
        nationality:
          type: string
        id_card_address:
          type: string
        residence_address:
          type: string
        phone_number:
          type: string
        identity_number:
          type: string
        npwp_number:
          type: string
        bpjs_number:
          type: string
        bpjs_tkn_number:
          type: string
        kk_number:
          type: string
        insurance_number:
          type: string
        emergency_contact:
          type: string
        bank_name:
          type: string
        bank_branch:
          type: string
        bank_acc_number:
          type: string
        bank_acc_name:
