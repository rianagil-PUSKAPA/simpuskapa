{
  "name": "sim-puskapa-desktop",
  "version": "0.2.0",
  "description": "SIM PUSKAPA desktop client for Windows and macOS",
  "author": "PUSKAPA",
  "private": true,
  "license": "UNLICENSED",
  "main": "main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:smoke": "node --test test/electron.smoke.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist:win": "electron-builder --win nsis msi --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "prettier": "2.8.6",
    "prettier-plugin-tailwindcss": "0.2.5",
    "typescript": "4.7.4"
  }
}
