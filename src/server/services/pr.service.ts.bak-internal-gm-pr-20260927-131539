  syncAPRToPR(budgets: ActivityBudgetList[], apr: any): ActivityBudgetList[] {
    const aprBudgets: ActivityBudgetList[] = apr.pr_budgets as ActivityBudgetList[]

    for (const budget of budgets) {
      const aprMatched = aprBudgets.filter((aprBudget) => {
        return budget.id == aprBudget.id
      })

      if (aprMatched.length > 0) {
        budget.advance_payment_total = aprMatched[0].advance_payment_total
      }
    }

    return budgets
  }

  async recalculateTax(pr_id: string): Promise<string> {
    const pr = await this.prRepository.getPRById(pr_id)

    const rf = await this.rfRepository.getRfByOnlyId(pr.rf_id)

    const program = await this.programRepository.getById(rf.program_id)

    if (pr.vendor_id) {
      const vendor = await this.vendorRepository.getVendorById(pr.vendor_id)
      if (vendor) {
        const aboutVEndorEval = {
          Individual: false,
          Group: true,
          individual: false,
          group: true,
          'Warga Negara Indonesia': TaxNationality.WNI,
          'Warga Negara Asing': TaxNationality.WNA,
          warga_negara_indonesia: TaxNationality.WNI,
          warga_negara_asing: TaxNationality.WNA,
        }
        let taxCalculationResult: CalculationTaxResult
        try {
          const tax = new TaxCalculation({
            with_npwp: true,
            with_ppn: pr.with_ppn,
            nationality:
              aboutVEndorEval[
                vendor.vendor_information['nationality'] == undefined
                  ? 'Warga Negara Indonesia'
                  : vendor.vendor_information['nationality']
              ],
            is_organization:
              aboutVEndorEval[
                vendor.vendor_information['organization_type'] == undefined
                  ? 'Individual'
                  : vendor.vendor_information['organization_type']
              ],
          } as TaxParam)
          console.log(tax)

          const prHistories = []

          const prs = await this.prRepository.getListPRAll(program.id, pr.rf_id, null, false, null, vendor.id)
          for (const pr of prs) {
            const detail = await this.getPrDetail(pr.id)
            prHistories.push(detail)
          }

          const vendorType = await this.vendorRepository.getVendorTypeById(vendor.vendor_type)
          if (!vendorType) {
            throw new ServerBadRequest('Vendor type not found')
          }
          console.log('CALCULATION TYPE', vendorType)
          if (vendorType.tax_calculation_type == 'CALCULATE') {
            const currentPr = await this.getPrDetail(pr_id)
            prHistories.push(currentPr)
            taxCalculationResult = tax.setPaymentRequesstHistory(prHistories).calculate(currentPr)
          } else if (vendorType.tax_calculation_type == 'SKIP') {
            taxCalculationResult = {
              calculation_params: {} as CalculationTaxParam,
              taxes: [
                {
                  tax_type: 'NO TAX',
                  total_tax: 0,
                  percentage: 0,
                  is_tier: false,
                } as PRTaxes,
              ],
            } as CalculationTaxResult
          } else if (vendorType.tax_calculation_type == 'MANUAL') {
            taxCalculationResult = {
              calculation_params: {} as CalculationTaxParam,
              taxes: [
                {
                  tax_type: 'NO TAX',
                  total_tax: 0,
                  percentage: 0,
                  is_tier: false,
                } as PRTaxes,
              ],
            } as CalculationTaxResult
          }

          await this.prRepository.updateById(pr_id, {
            tax: JSON.stringify(taxCalculationResult),
          })

          return JSON.stringify(taxCalculationResult)
        } catch (e) {
          console.log(e)
          console.log(pr)
          throw new ServerBadRequest(`Tax calculation failed ${JSON.stringify(taxCalculationResult)} - ${e}`)
        }
      } else {
        throw new ServerBadRequest('Tax calculation failed - vendor information not found')
      }
    } else {
      // without tax cslculation

      return 'IS NOT TAX'
    }
  }

