  async updatePaymentRequest(pr: CreatePaymentRequestApiRequest, prId: string, userId: string): Promise<string> {
    console.log('USER', userId)
    let submittedByEmployee = await this.emplyeeRepository.getEmployeeByUserId(userId)

    if (pr.created_by) {
      submittedByEmployee = await this.emplyeeRepository.getEmployeeByEmployeeId(pr.created_by)
    }

    if (submittedByEmployee.length <= 0) {
      throw new ServerNotFound('submited employee by not found')
    }

    const rf = await this.rfRepository.getRfByOnlyId(pr.rf_id)
    const program = await this.programRepository.getById(rf.program_id)

    // get current HOF and HOO
    const hofUser = await this.userRepository.getUserByRole(RoleDefinition.HEAD_OF_FINANCE)
    if (!hofUser) {
      throw new ServerBadRequest('Head Of Finance has not been set')
    }
    const hof = await this.emplyeeRepository.getEmployeeByUserId(hofUser.id)

    const hooUser = await this.userRepository.getUserByRole(RoleDefinition.HEAD_OF_OPERATION)
    if (!hooUser) {
      throw new ServerBadRequest('Head Of Operation has not been set')
    }

    for (const budget of pr.budgets as any) {
      if (budget.is_dynamic != undefined) {
        if (budget.activity_id == undefined) {
          continue
        }
        await this.budgetRepository.add({
          id: budget.id,
          activity_id: budget.activity_id,
          ordering_seq: budget.ordering_seq,
          code: budget.code,
          description: budget.description,
          vendor_category_info_id: budget.vendor_category_id,
          qty: budget.qty,
          unit: budget.unit,
          pkg_qty: budget.pkg_qty,
          pkg_unit: budget.pkg_unit,
          cost: budget.unit_cost_value,
        })

        const budgetDetail = await this.budgetRepository.getDetailBudgetUpTree(budget.id)
        if (!budgetDetail) {
          continue
        }
      }
    }

    //if in this RF has APR get budget apr and match with budget id
    const apr = await this.prRepository.getListPrByTypeAndRfID(rf.id, pr.payment_type)
    if (apr.length > 0 && pr.payment_type == PRTypes.PR) {
      this.syncAPRToPR(pr.budgets, apr)
    }

    if (pr.vendor_id) {
      const vendor = await this.vendorRepository.getVendorById(pr.vendor_id)
      if (vendor) {
        const aboutVEndorEval = {
          Individual: false,
          Group: true,
          'Warga Negara Indonesia': TaxNationality.WNI,
          'Warga Negara Asing': TaxNationality.WNA,
        }
        let taxCalculationResult: CalculationTaxResult
        try {
          const tax = new TaxCalculation({
            with_npwp: true,
            with_ppn: pr.with_ppn,
            nationality:
              aboutVEndorEval[
                vendor.vendor_information['nationality'] == undefined
                  ? 'Warga Negara Indonesia'
                  : vendor.vendor_information['nationality']
              ],
            is_organization:
              aboutVEndorEval[
                vendor.vendor_information['organization_type'] == undefined
                  ? 'Individual'
                  : vendor.vendor_information['organization_type']
              ],
          } as TaxParam)

          const prHistories = []

          const prs = await this.prRepository.getListPRAll(program.id, pr.rf_id, null, false, null, vendor.id)
          for (const pr of prs) {
            const detail = await this.getPrDetail(pr.id)
            prHistories.push(detail)
          }

          if (pr.budgets) {
            for (const budget of pr.budgets) {
              const chekedBudget = await this.budgetRepository.getDetailBudgetUpTree(budget.id)

              if (!chekedBudget) {
                throw new BadRequestException('Budget Not Found')
              }
            }
          }

          const payload = {
            rf_id: pr.rf_id,
            description: pr.description,
            vendor_id: pr.vendor_id,
            with_ppn: pr.with_ppn,
            pr_budgets: JSON.stringify(pr.budgets),
            attachments: JSON.stringify(pr.attachments),
            expected_payment_date: pr.expected_payment_date,
            requested_by: submittedByEmployee[0].id,
            head_of_finance_approval: PRApprovalStatus.PENDING.toString(),
            budget_controller_approval: PRApprovalStatus.APPROVED.toString(),
            program_manager_approval: PRApprovalStatus.PENDING.toString(),
            aps_budget_controller_approval: PRApprovalStatus.APPROVED.toString(),
            aps_haed_of_finance_approval: PRApprovalStatus.PENDING.toString(),
            payment_type: pr.payment_type,
            aps_result: pr.aps_result,
            aps_related_apr_id: pr.aps_related_pr_id,
            travel_end_date_estimation: pr.travel_end_date_estimation,
            spending_deadline: pr.spending_deadline,
            head_of_finance_approval_by: hof[0].id,
          }
          if (!pr.created_by) {
            payload['finance_checking_process_by'] = null
            payload['finance_checking_process_status'] = null
            payload['requested_at'] = new Date().toISOString()
          }
          const inserted = await this.prRepository.updateById(prId, payload)

          const vendorType = await this.vendorRepository.getVendorTypeById(vendor.vendor_type)
          if (!vendorType) {
            throw new ServerBadRequest('Vendor type not found')
          }

          if (vendorType.tax_calculation_type == 'CALCULATE') {
            const currentPr = await this.getPrDetail(inserted.id)
            prHistories.push(currentPr)
            taxCalculationResult = tax.setPaymentRequesstHistory(prHistories).calculate(currentPr)
          } else if (vendorType.tax_calculation_type == 'SKIP') {
            taxCalculationResult = {
              calculation_params: null,
              taxes: [
                {
                  tax_type: 'NO TAX',
                  total_tax: 0,
                  percentage: 0,
                  is_tier: false,
                } as PRTaxes,
              ],
            } as CalculationTaxResult
          } else if (vendorType.tax_calculation_type == 'MANUAL') {
            taxCalculationResult = {
              calculation_params: null,
              taxes: [
                {
                  tax_type: 'NO TAX',
                  total_tax: 0,
                  percentage: 0,
                  is_tier: false,
                } as PRTaxes,
              ],
            } as CalculationTaxResult
          }

          await this.prRepository.updateById(inserted.id, {
            tax: JSON.stringify(taxCalculationResult),
          })

          const finance_team_members = await this.emplyeeRepository.getEmployeeByDepartment('Finance')
          for (const finance_team of finance_team_members) {
            await this.notifRepo.create({
              employee_id: finance_team.id,
              ref_id: inserted.id,
              notif_type: NotifType.ACTION_PAYMENT_REQUEST_CHECK,
              deleted_at: null,
            })
          }

          return inserted.id
        } catch (e) {
          console.log(e)
          console.log(pr)
          throw new ServerBadRequest('Tax calculation failed')
        }
      } else {
        throw new ServerBadRequest('Tax calculation failed - vendor information not found')
      }
    } else {
      // without tax cslculation
      if (pr.budgets) {
        for (const budget of pr.budgets) {
          const chekedBudget = await this.budgetRepository.getDetailBudgetUpTree(budget.id)

          if (!chekedBudget) {
            throw new BadRequestException('Budget Not Found')
          }
        }
      }
      const payload = {
        rf_id: pr.rf_id,
        description: pr.description,
        with_ppn: pr.with_ppn,
        pr_budgets: JSON.stringify(pr.budgets),
        attachments: JSON.stringify(pr.attachments),
        expected_payment_date: pr.expected_payment_date,
        requested_by: submittedByEmployee[0].id,
        head_of_finance_approval: PRApprovalStatus.PENDING.toString(),
        budget_controller_approval: PRApprovalStatus.APPROVED.toString(),
        program_manager_approval: PRApprovalStatus.PENDING.toString(),
        aps_budget_controller_approval: PRApprovalStatus.APPROVED.toString(),
        aps_haed_of_finance_approval: PRApprovalStatus.PENDING.toString(),
        payment_type: pr.payment_type,
        aps_result: pr.aps_result,
        aps_related_apr_id: pr.aps_related_pr_id,
        travel_end_date_estimation: pr.travel_end_date_estimation,
        spending_deadline: pr.spending_deadline,
        head_of_finance_approval_by: hof[0].id,
      }
      if (!pr.created_by) {
        payload['finance_checking_process_by'] = null
        payload['finance_checking_process_status'] = null
        payload['requested_at'] = new Date().toISOString()
      }

      const inserted = await this.prRepository.updateById(prId, payload)

      const finance_team_members = await this.emplyeeRepository.getEmployeeByDepartment('Finance')
      for (const finance_team of finance_team_members) {
        await this.notifRepo.create({
          employee_id: finance_team.id,
          ref_id: inserted.id,
          notif_type: NotifType.ACTION_PAYMENT_REQUEST_CHECK,
          deleted_at: null,
        })
      }
      return inserted.id
    }
  }
}
