  async getListOfBankAccountToTransferByEmployeeId(user_id: string): Promise<FinanceProcessBankAccount[]> {
    const employee = await this.emplyeeRepository.getEmployeeByUserId(user_id)
    const transfers: FinanceProcessBankAccount[] = []
    const prs: payment_request[] = await this.prRepository.getPRByFInanceProcessBy(employee[0].id)

    if (!prs) {
      return []
    }
    if (prs.length == 0) {
      return []
    }
    console.log('trasfer list', prs)
    for (const pr of prs) {
      if (!pr.vendor_id) {
        continue
      }

      const rf = await this.rfRepository.getRfById('', '', pr.rf_id)
      if (!rf) {
        continue
      }
      const program = await this.programRepository.getById(rf.program_id)
      if (!program) {
        continue
      }

      const prDetail = await this.getPrDetail(pr.id, '')

      const vendor = await this.vendorRepository.getVendorById(pr.vendor_id)
      if (vendor.vendor_payment) {
        transfers.push({
          pr_number: pr.request_number,
          pr_description: pr.description,
          transfer_deadline: pr.payment_date ? pr.payment_date.toString() : '-',
          transfer_to: vendor.vendor_payment as VendorPayment,
          project_name: program.program_name,
          amount: prDetail.transfer_amount,
        } as FinanceProcessBankAccount)
      }
    }

    return transfers
  }

