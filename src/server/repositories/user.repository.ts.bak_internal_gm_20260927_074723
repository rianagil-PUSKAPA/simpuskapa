import { Injectable } from '@nestjs/common'
import { Prisma, users as User, users } from '@prisma/client'
import { CommonPrismaClient } from '@server/common/prisma.client'
import axios from 'axios'
import { GoogleToken, GoogleUserInformation } from '../types/google.token'

@Injectable()
export class UserRepository {
  constructor(private prisma: CommonPrismaClient) {}

