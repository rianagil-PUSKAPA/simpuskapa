type Props = {
  children?: JSX.Element | JSX.Element[]
  programId: string
  task: string
  action: string
  forceAllow?: boolean
  isActionBy?: boolean
  isTraveller?: boolean
  isRFRequester?: boolean
  replaceWith?: JSX.Element
}

const ProgramRoleAccessControlProvider = ({
  children,
  programId,
  task,
  action,
  forceAllow = false,
  replaceWith,
  isActionBy = false,
  isTraveller = false,
  isRFRequester = false,
}: Props) => {
  const { handleProgramAccessor, isInternal } = useDashboardContext()
  const [allow, setAllow] = useState<boolean>(null)
  const [allowDebounce, setAllowDebounce] = useState<boolean>(null)
  const [renderView, setRenderView] = useState<boolean>(false)

  // console.log('lelele---allowDebounce', allowDebounce)
  // console.log('lelele---allow', allow)

  const supervisorId = async (employeeId: string) => {
    const employeeDetail = await employeeApi.employeeControllerGetEmployeeDetail(employeeId)
    return employeeDetail.data.data.employee_contracts[0].supervisor_id
  }

  const checkAccees = async (
    employeeId: string,
    userRole: string[],
    task: string,
    action: string,
    programId: string,
  ) => {
    // console.log('xxxx-employeeId', employeeId)
    // console.log('xxxx-userRole', userRole)
    // console.log('xxxx-task', task)
    // console.log('xxxx-action', action)
    // console.log('xxxx-programId', programId)

    // console.log('FORCE ALLOW', forceAllow)
    if (forceAllow) {
      return true
    }

    // console.log(
    //   `EMPLOYEE ID: ${employeeId} - PROGRAM ID: ${programId} - TASK: ${task}`,
    // )

    const programDetailResponse = await programApi.programControllerGetProgramDetail(programId)
    const program = programDetailResponse.data.data
    // check id desired employee id has access on task as accesor to program

    // determine is user grant manager or program manager or else .....
    // use list bc it might be same employeeid on one program
    const programAccessorTypes = []

    const isInternalProject = program?.program_ownership_type === 'INTERNAL'

    const spvId = program?.created_by?.id ? await supervisorId(program.created_by.id) : null

    if (isInternalProject && spvId && String(employeeId) === String(spvId)) {
      programAccessorTypes.push(programAccessor.SUPERVISOR)
    }

    // Project Manager hanya berlaku untuk PROGRAM.
    if (!isInternal && employeeId == program?.program_manager?.id) {
      programAccessorTypes.push(programAccessor.PROGRAM_MANAGER)
    }
    // Grant Manager hanya berlaku untuk PROGRAM.
    if (!isInternal && employeeId == program?.grant_manager?.id) {
      programAccessorTypes.push(programAccessor.GRANT_MANAGER)
    }

    // check if budget controller
    // if (employeeId == program?.budget_controller?.id) {
    //  programAccessorTypes.push(programAccessor.BUDGET_CONTROLLER)
    // }

    // Program Officer hanya berlaku untuk PROGRAM.
    if (!isInternal && employeeId == program?.program_officer?.id) {
      programAccessorTypes.push(programAccessor.PROGRAM_OFFICER)
    }
    // Check if incoming data is action_by same as logged user
    if (isActionBy) {
      programAccessorTypes.push(programAccessor.ACTION_BY)
    }
    // Check is currect data is accessed by RF requester
    if (isRFRequester) {
      programAccessorTypes.push(programAccessor.REQUESTER_RF)
    }
    // Check if incoming data is who_is_travel same as logged user
    if (isTraveller) {
      programAccessorTypes.push(programAccessor.TRAVELLER)
    }

    // check if head of finance
    if (userRole?.includes(RoleDefinition.HEAD_OF_FINANCE)) {
      programAccessorTypes.push(programAccessor.HEAD_OF_FINANCE)
    }
    // check if teams of finance
    if (userRole?.includes(RoleDefinition.FINANCE_TEAM)) {
      programAccessorTypes.push(programAccessor.FINANCE_TEAM)
    }
    // check if head of operation
    if (userRole?.includes(RoleDefinition.HEAD_OF_OPERATION)) {
      programAccessorTypes.push(programAccessor.HEAD_OF_OPERATION)
    }
    // check if general manager
    if (userRole?.includes(RoleDefinition.GENERAL_MANAGER)) {
      programAccessorTypes.push(programAccessor.GENERAL_MANAGER)
    }
    // check if teams of operation
    if (userRole?.includes(RoleDefinition.OPS_TEAM)) {
      programAccessorTypes.push(programAccessor.OPERATION_TEAM)
    }

    if (programAccessorTypes.length == 0) {
      // set as non role if accesor 0
      programAccessorTypes.push(programAccessor.NON_PROGRAM_ROLE)
    }

    // console.log('programAccessorTypes', programAccessorTypes)
    // console.log('userRole', userRole)

    handleProgramAccessor(programAccessorTypes)

    // INTERNAL Budget Needs:
    // The employee who created the INTERNAL project owns
    // CREATE / UPDATE / SUBMIT Budget Needs.
    if (isInternalProject && program?.created_by?.id && String(employeeId) === String(program.created_by.id)) {
      if (
        (task === programTasks.ADD_BUDGET_NEED && action === accessActionType.CREATE) ||
        (task === programTasks.EDIT_BUDGET_NEED && action === accessActionType.UPDATE) ||
        (task === programTasks.SUBMIT_BUDGET_NEED && action === accessActionType.SUBMIT)
      ) {
        return true
      }
    }

    // =====================================================
    // INTERNAL PROJECT CREATOR
    // =====================================================
    // created_by adalah owner project/activity/budget pada
    // project INTERNAL.
    const isInternalCreator = isInternal && employeeId === program?.created_by?.id

    // INTERNAL creator boleh membuat activity.
    if (isInternalCreator && task === programTasks.CREATE_PROJECT_ACTIVITY && action === accessActionType.CREATE) {
      return true
    }

    // INTERNAL creator boleh mengubah activity.
    if (isInternalCreator && task === programTasks.EDIT_PROJECT_ACTIVITY && action === accessActionType.UPDATE) {
      return true
    }

    // INTERNAL creator boleh ADD / EDIT / SUBMIT Budget Needs.
    if (
      isInternalCreator &&
      ((task === programTasks.ADD_BUDGET_NEED && action === accessActionType.CREATE) ||
        (task === programTasks.EDIT_BUDGET_NEED && action === accessActionType.UPDATE) ||
        (task === programTasks.SUBMIT_BUDGET_NEED && action === accessActionType.SUBMIT))
    ) {
      return true
    }

    // =====================================================
    // PROGRAM BUDGET NEEDS
    // =====================================================
    // Program Officer boleh edit.
    if (
      !isInternal &&
      employeeId === program?.program_officer?.id &&
      task === programTasks.EDIT_BUDGET_NEED &&
      action === accessActionType.UPDATE
    ) {
      return true
    }

    // Grant Manager tidak boleh membuka/edit/add/submit
    // Budget Needs. Grant Manager hanya untuk approval.
    if (
      !isInternal &&
      employeeId === program?.grant_manager?.id &&
      ((task === programTasks.ADD_BUDGET_NEED && action === accessActionType.CREATE) ||
        (task === programTasks.EDIT_BUDGET_NEED && action === accessActionType.UPDATE) ||
        (task === programTasks.SUBMIT_BUDGET_NEED && action === accessActionType.SUBMIT))
    ) {
      return false
    }
    // INTERNAL Budget Needs:
    // approval is available to the User Management
    // role HEAD_OF_OPERATION and GENERAL MANAGER
    if (
      isInternal &&
      userRole?.includes(RoleDefinition.GENERAL_MANAGER) &&
      task === programTasks.APPROVE_BUDGET_NEED &&
      action === accessActionType.CREATE
    ) {
      return true
    }

    for (const access of ProgramAccessControlCore.access) {
      if (access.task == task) {
        for (const programAccesorType of programAccessorTypes) {
          for (const taskAccess of access.access) {
            if (taskAccess.accessor == programAccesorType) {
              // console.log('kokoko-taskAccess.accessor', taskAccess.accessor)
              // console.log('kokoko-programAccesorType', programAccesorType)
              // console.log('kokoko-action', action)
              // console.log('kokoko-taskAccess.allowed', taskAccess.allowed)

              if (taskAccess.forbid?.length > 0) {
                // console.log('CHECK FORBID', taskAccess.forbid, action)
                if (taskAccess.forbid.includes(action)) {
                  return false
                }
              }

              // console.log('CHECK ALLOWED', task, taskAccess.allowed, action)
              // console.log('taskAccess', taskAccess)
              if (taskAccess.allowed.includes(action)) {
                if (task === programTasks.CREATE_PROJECT_ACTIVITY || task === programTasks.EDIT_PROJECT_ACTIVITY) {
                  if (!isInternal && taskAccess.accessor === programAccessor.SUPERVISOR) {
                    return false
                  }
                }

                if (task === programTasks.ADD_BUDGET_NEED) {
                  if (
                    !isInternal &&
                    (taskAccess.accessor === programAccessor.HEAD_OF_OPERATION ||
                      taskAccess.accessor === programAccessor.SUPERVISOR ||
                      taskAccess.accessor === programAccessor.GENERAL_MANAGER)
                  ) {
                    return false
                  }
                }

                if (task === programTasks.REVISE_BUDGET_NEED) {
                  if (!isInternal && taskAccess.accessor === programAccessor.SUPERVISOR) {
                    return false
                  }
                }

                return true
              }

              // console.log('kokoko-programAccesorType', programAccesorType)
            }
          }
        }
      }
    }

    return false
  }

  // eslint-disable-next-line @typescript-eslint/no-unused-vars
  const handleForbiddenAccess = (reason: string) => {
    /*
     * here u can show alert or modal or anything
     * or by default replaced by this.props.replaceWith component if exist or just hide the cild component
     * */
    setAllow(false)
  }

  useEffect(() => {
    setAllow(null)
    setRenderView(false)

    const exec = async () => {
      if (!getLocalCookie('auth_token')) {
        setAllow(false)
      }

      await JwtLib.decodeOnly(getLocalCookie('auth_token'))
        .then((claim) => {
          const employeeId: string = claim['employee_id']

          if (claim['role']?.includes(RoleDefinition.SUPERADMIN)) {
            setAllow(true)
            setRenderView(true)
          } else {
            checkAccees(employeeId, claim['role'], task, action, programId)
              .then((allowed) => {
                if (allowed) {
                  setAllow(true)
                } else {
                  handleForbiddenAccess('NO ACCESS 1')
                }
              })
              .catch((err) => {
                console.error(`NO ACCESS 2 ${err}`)
                handleForbiddenAccess('NO ACCESS 2')
              })
              .finally(() => {
                setRenderView(true)
              })
          }
        })
        .catch((err) => {
          handleForbiddenAccess(`NO ACCESS 3 ${err}`)
        })
    }

    exec()
    setAllowDebounce(true)
  }, [getLocalCookie('auth_token'), programId, task, action, forceAllow, isActionBy, isTraveller, isRFRequester])

  if (allowDebounce === null || allow === null || renderView === false) {
    return <></>
  }

  if (!allow) {
    return <>{replaceWith}</>
  }

  return <>{children}</>
}

export default ProgramRoleAccessControlProvider
