  } as const

  type TabSlug = keyof typeof TAB_CONFIG

  // Helper functions
  const getIndexFromTab = (tab: string | string[] | undefined): number => {
    const tabKey = (tab || 'detail-rf') as TabSlug
    return TAB_CONFIG[tabKey]?.index ?? 0
  }

  const getTabFromIndex = (indexValue: number): TabSlug => {
    // eslint-disable-next-line @typescript-eslint/no-unused-vars
    const entry = Object.entries(TAB_CONFIG).find(([_, config]) => config.index === indexValue)
    return (entry?.[0] as TabSlug) ?? 'detail-rf'
  }

  // Derive index from URL query param (single source of truth)
  const index = getIndexFromTab(router.query.tab)

  const [isApprovedByPMHOO, setIsApprovedByPMHOO] = useState(false)
  const [loadingButtonStatement, setLoadingButtonStatement] = useState<{
    'payment-request': boolean
    'advance-payment-request': boolean
    'advance-perdiem-fee': boolean
    'travel-expense': boolean
    'advance-payment-statement': boolean
    exportExcel: boolean
    approve: boolean
    reject: boolean
    deleteRf: boolean
    closeRF: boolean
  }>({
    [PRTypes.PR]: false,
    [PRTypes.APR]: false,
    [PRTypes.APF]: false,
    [PRTypes.TE]: false,
    [PRTypes.APS]: false,
    exportExcel: false,
    approve: false,
    reject: false,
    deleteRf: false,
    closeRF: false,
  })

  const { data: supervisorData, trigger: supervisorTrigger } = useSWRMutation(
    [requisitionFormDetail ? requisitionFormDetail?.requested_by.id : null],
    ([id]) => supervisorByEmployee(id),
  )

  const { data: perdiemSettingData, trigger: perdiemSettingTrigger } = useSWRMutation(`${programId}`, getPerdiemSetting)

  const {
    register,
    handleSubmit,
    formState: { errors },
  } = useForm<RFApprovalStatusRequest>()

  const openTravelInformationDrawer = () => {
    setTravelInformationDrawer(true)
  }
  const openPersoanlHireInformationDrawer = () => {
    setPersonalHireDrawer(true)
  }
  const openViewLogActivityDrawer = () => {
    setViewLogActivityDrawer(true)
  }

  const rejectHandler: SubmitHandler<RFApprovalStatusRequest> = async (input) => {
    setLoadingButtonStatement((prev) => ({ ...prev, reject: true }))

    const approvalResponse = requisitionFormApi.rFControllerApproveRF(programId, rfId, projectId, {
      approved_by: RFApprovalBy.BY_PROGRAM_MANAGER.toString(),
      status: 'rejected',
      rejection_note: input.rejection_note,
    } as RFApprovalStatusRequest)

    toast.promise(approvalResponse, {
      pending: 'Rejecting requisition form',
      success: 'Requisition form rejected',
      error: 'Promise rejected 🤯',
    })

    approvalResponse.then(() => {
      router.replace(router.asPath)
      closeRejectConfirmationModal()
    })

    approvalResponse.finally(() => {
      setLoadingButtonStatement((prev) => ({ ...prev, reject: false }))
    })
  }

  const saveExcel = () => {
    saveExcelRf(
      setLoadingButtonStatement,
      programDetail,
      requisitionFormDetail,
      rfType,
      vendorDetail,
      supervisorData,
      isInternal,
      projectBudgetsModified,
      userLoggedinInformation,
      isTravelInformationStatement,
      programId,
      rfId,
      perdiemSettingData,
      travellerPerdiemTax,
    )
  }

  /**
   * Handles the payment request.
   *
   * @param {string} parameter - The parameter that determines the type of payment request.
   *    Possible values are 'PR' (Payment Request), 'APR' (Advance Payment Request), or 'TE' (Travel Expense).
   */
  const handlePaymentRequest = (parameter: PaymentIdentifierType) => {
    let filteredActivities = null

    if (parameter === PRTypes.APF) {
      filteredActivities = projectBudgetsModified
        .flatMap((project) =>
          project.activities
            .filter((activity) => activity.budgets.some((budget) => budget.id))
            .map((activity) => ({
              ...activity,
              budgets: activity.budgets.filter(
                (budget) =>
                  budget.vendor_category_information.name === 'Overseas Perdiem' ||
                  budget.vendor_category_information.name === 'Normal Perdiem' ||
                  budget.vendor_category_information.name === 'Remote Area Perdiem',
              ),
            })),
        )
        .filter((project) => project.budgets.length > 0)
    }
    if (parameter === PRTypes.TE) {
      filteredActivities = projectBudgetsModified.flatMap((project) =>
        project.activities
          .filter((activity) => activity.budgets.some((budget) => budget.id))
          .map((activity) => ({
            ...activity,
            budgets: activity.budgets.filter((budget) => budget.id),
          })),
      )
    }
    if (parameter === PRTypes.PR || parameter === PRTypes.APR) {
      filteredActivities = copyCheckedBudgetsWithActivities(projectBudgetsModified)
    }

    const getTypesOfBudget = filteredActivities.map((item) =>
      item.budgets.map((budget) => budget.vendor_category_information.vendor_type.name),
    )
    const getCategoriesOfBudget = filteredActivities.map((item) =>
      item.budgets.map((budget) => budget.vendor_category_information.name),
    )

    const flattenTypes = getTypesOfBudget.flat()
    const flattenCategories = getCategoriesOfBudget.flat()

    const sampleElement = flattenTypes[0]

    const isAllSameValueType = flattenTypes.every((element) => element === sampleElement)

    const perdiemCollections = flattenCategories.filter(
      (element) => element === 'Overseas Perdiem' || element === 'Normal Perdiem' || element === 'Remote Area Perdiem',
    )

    let projectWithChecked = null

    if (parameter === PRTypes.APF || parameter === PRTypes.TE) {
      projectWithChecked = projectBudgetsModified.find((item) =>
        item.activities.some((activity) => activity.budgets.some((budget) => budget.id)),
      )

      if (parameter === PRTypes.TE && perdiemCollections.length > 1) {
        setIsOpenModal((prev: ModalStatement) => ({
          ...prev,
          doublePerdiem: true,
        }))
        setLoadingButtonStatement((prev) => ({ ...prev, [parameter]: false }))
        return false
      }

      if (parameter === PRTypes.TE) {
        const flattenExistingTEBudget = projectWithChecked.activities
          .map((activity) =>
            activity.budgets.filter((budget) => budget.vendor_category_information.action_by === 'ACTION_BY_TRAVELLER'),
          )
          .flat()

        const totallyPaidStatements = flattenExistingTEBudget.map((budget) => budget.totally_paid)

        // Will show warning if all budget was paid
        if (!totallyPaidStatements.includes(false)) {
          toast.warning("Can't create travel expense, because all budget was paid", {
            icon: <AlertTriangleIcon className="h-5 w-5 stroke-warning-500" />,
            autoClose: 10000,
          })
          setLoadingButtonStatement((prev) => ({ ...prev, [parameter]: false }))
          return false
        }
      }
    }

    if (parameter === PRTypes.PR || parameter === PRTypes.APR) {
      if (filteredActivities.length === 0) {
        toast.warning('Please select at least one budget activity', {
          autoClose: 10000,
        })
        setLoadingButtonStatement((prev) => ({ ...prev, [parameter]: false }))
        return false
      }

      projectWithChecked = projectBudgetsModified.find((item) =>
        item.activities.some((activity) => activity.budgets.some((budget) => budget.is_checked)),
      )
      if (!isAllSameValueType) {
        setIsOpenModal((prev: ModalStatement) => ({
          ...prev,
          paymentRequest: true,
        }))
        setLoadingButtonStatement((prev) => ({ ...prev, [parameter]: false }))
        return false
      }
    }

    // eslint-disable-next-line @typescript-eslint/no-unused-vars
    const { activities, ...itemWithoutActivities } = projectWithChecked
    // return false

    handleRequisitionBudgetToPaymentRequest(filteredActivities)
    handleProjectToPaymentRequest(itemWithoutActivities)

    switch (parameter) {
      case PRTypes.PR:
        handlePaymentRequestIdentifier('PR')
        router.push(`/dashboard/finance/payment-request/pr/${programId}/${projectId}/${rfId}`)
        setLoadingButtonStatement((prev) => ({ ...prev, [parameter]: false }))
        break
      case PRTypes.APR:
        handlePaymentRequestIdentifier('APR')
        router.push(`/dashboard/finance/payment-request/apr/${programId}/${projectId}/${rfId}`)
        setLoadingButtonStatement((prev) => ({ ...prev, [parameter]: false }))
        break
      case PRTypes.APF:
        const isPerdiemExist = filteredActivities.map((activity) =>
          activity.budgets.some(
            (budget) =>
              budget.vendor_category_information.name === 'Overseas Perdiem' ||
              budget.vendor_category_information.name === 'Normal Perdiem' ||
              budget.vendor_category_information.name === 'Remote Area Perdiem',
          ),
        )

        const isPerdiemExistValue = isPerdiemExist.some((item: boolean) => item === true)

        if (!isPerdiemExistValue) {
          toast.warning("Perdiem category not found, Can't create advance perdiem fee without it")
          setLoadingButtonStatement((prev) => ({ ...prev, [parameter]: false }))
          return false
        }

        handlePaymentRequestIdentifier('APF')
        router.push(`/dashboard/finance/payment-request/apf/${programId}/${projectId}/${rfId}`)
        setLoadingButtonStatement((prev) => ({ ...prev, [parameter]: false }))
        break
      case PRTypes.TE:
        handlePaymentRequestIdentifier('TE')
        router.push(`/dashboard/finance/payment-request/te/${programId}/${projectId}/${rfId}`)
        setLoadingButtonStatement((prev) => ({ ...prev, [parameter]: false }))
        break
      default:
        break
    }
  }

  const handleActivityChange = (activityId, isChecked) => {
    const newBudgetNeeds = projectBudgets.map((item) => {
      if (item.activities.some((activity) => activity.id === activityId)) {
        item.activities = item.activities.map((activity) => {
          if (activity.id === activityId) {
            activity.is_checked = isChecked
            activity.budgets = activity.budgets.map((budget) => {
              budget.is_checked = isChecked
              return budget
            })
          }
          return activity
        })
      }
      return item
    })
    setProjectBudgets(newBudgetNeeds)
  }

  const handleBudgetChange = (activityId, budgetId, isChecked) => {
    let isAllChecked = true
    const newBudgetNeeds = projectBudgets.map((item) => {
      if (item.activities.some((activity) => activity.id === activityId)) {
        item.activities = item.activities.map((activity) => {
          if (activity.id === activityId) {
            activity.budgets = activity.budgets.map((budget) => {
              if (budget.id === budgetId) {
                budget.is_checked = isChecked
              }
              if (!budget.is_checked) {
                isAllChecked = false
              }
              return budget
            })
            activity.is_checked = isAllChecked
          }
          return activity
        })
      }
      return item
    })
    setProjectBudgets(newBudgetNeeds)
  }

  const handleIndexTabs = (value: number) => {
    const tab = getTabFromIndex(value)
    router.push({
      pathname: router.pathname,
      query: {
        ...router.query,
        tab,
      },
    })
  }

  const openDeleteConfirmationModal = () => {
    setIsOpenModal((prev: ModalStatement) => ({
      ...prev,
      deleteConfirmationModal: true,
    }))
  }

  const closeDeleteConfirmationModal = () => {
    setIsOpenModal((prev: ModalStatement) => ({
      ...prev,
      deleteConfirmationModal: false,
    }))
  }

  const showCLoseRfConfirmationModal = () => {
    setIsOpenModal((prev: ModalStatement) => ({
      ...prev,
      closeRfConfirmationModal: true,
    }))
  }

  const hideCloseRfConfirmationModal = () => {
    setIsOpenModal((prev: ModalStatement) => ({
      ...prev,
      closeRfConfirmationModal: false,
    }))
  }

  const openRejectConfirmationModal = () => {
    setIsOpenModal((prev: ModalStatement) => ({
      ...prev,
      reject: true,
    }))
  }

  const closeRejectConfirmationModal = () => {
    setIsOpenModal((prev: ModalStatement) => ({
      ...prev,
      reject: false,
    }))
  }

  const deletePayment = () => {
    setLoadingButtonStatement((prev) => ({ ...prev, deleteRF: true }))

    const deletedRF = requisitionFormApi.rFControllerDeleteRFById(
      programId,
      requisitionFormDetail.projects[0].id,
      requisitionFormDetail.id,
    )

    toast.promise(deletedRF, {
      pending: 'Deleting requisition detail',
      success: 'Requisition deleted successfully',
      error: 'Promise rejected 🤯',
    })

    deletedRF.finally(() => {
      router.replace('/dashboard/procurement')

      setTimeout(() => {
        setLoadingButtonStatement((prev) => ({ ...prev, deleteRF: false }))
      }, 3000)
    })
  }

  const closeRfAction = () => {
    setLoadingButtonStatement((prev) => ({ ...prev, closeRF: true }))

    if (!isAllowedToCloseRF) {
      toast.error('You are not allowed to close this requisition form, because there are unpaid payment')
      setLoadingButtonStatement((prev) => ({ ...prev, closeRF: false }))
      return false
    }

    const closeRF = requisitionFormApi.rFControllerCloseRequisitionForm(
      programId,
      requisitionFormDetail.projects[0].id,
      requisitionFormDetail.id,
    )

    toast.promise(closeRF, {
      pending: 'Closing requisition form',
      success: 'Requisition form closed successfully',
      error: 'Promise rejected 🤯',
    })

    closeRF.finally(() => {
      supervisorTrigger()
      perdiemSettingTrigger()

      setTimeout(() => {
        setLoadingButtonStatement((prev) => ({ ...prev, closeRF: false }))
        hideCloseRfConfirmationModal()
        router.replace(router.asPath)
      }, 3000)
    })
  }

  const approveRequisitionForm = async (
    programId: string,
    projectId: string,
    rfId: string,
    status: RFApprovalStatus,
  ): Promise<void> => {
    if (status === RFApprovalStatus.APPROVED) {
      setLoadingButtonStatement((prev) => ({ ...prev, approve: true }))
    }
    if (status === RFApprovalStatus.REJECTED) {
      setLoadingButtonStatement((prev) => ({ ...prev, reject: true }))
    }

    const approvalRequest = requisitionFormApi.rFControllerApproveRF(programId, rfId, projectId, {
      approved_by: RFApprovalBy.BY_PROGRAM_MANAGER.toString(),
      status: status.toString(),
    } as RFApprovalStatusRequest)

    toast.promise(approvalRequest, {
      pending: `Processing Requisition Form Approval`,
      success: `Form Approval Done by ${isInternal ? 'General Manager' : 'Project Manager'}`,
      error: 'Failed to Approve Requisition Form',
    })

    if (status === RFApprovalStatus.APPROVED) {
      setLoadingButtonStatement((prev) => ({ ...prev, approve: false }))
    }
    if (status === RFApprovalStatus.REJECTED) {
      setLoadingButtonStatement((prev) => ({ ...prev, reject: false }))
    }

    setTimeout(() => {
      router.replace(router.asPath)
    }, 500)
  }

  const paymentRequestValidation = async (parameter: PaymentIdentifierType) => {
    setLoadingButtonStatement((prev) => ({ ...prev, [parameter]: true }))

    if (parameter === PRTypes.APR && rfType === RequisitionFormEnum.PERSONAL_HIRE) {
      toast.error("Personnel hire can't create advance payment request", {
        toastId: 'toast-ph-error',
      })
      setLoadingButtonStatement((prev) => ({ ...prev, [parameter]: false }))
      return false
    }

    const [getListAPRRes, getListPRRes, getListAPFRes, getListAPSRes, getListTERes] = await Promise.all([
      paymentRequestApi.pRControllerGetListPaymentRequest(programId, rfId, PRTypes.APR, undefined, undefined),
      paymentRequestApi.pRControllerGetListPaymentRequest(programId, rfId, PRTypes.PR, undefined, undefined),
      paymentRequestApi.pRControllerGetListPaymentRequest(programId, rfId, PRTypes.APF, undefined, undefined),
      paymentRequestApi.pRControllerGetListPaymentRequest(programId, rfId, PRTypes.APS, undefined, undefined),
      paymentRequestApi.pRControllerGetListPaymentRequest(programId, rfId, PRTypes.TE, undefined, undefined),
    ])

    const prListResults = getListAPRRes.data.data
    const aprListResults = getListPRRes.data.data
    const apfListResults = getListAPFRes.data.data
    const apsListResults = getListAPSRes.data.data
    const teListResults = getListTERes.data.data

    const mergePaymentResults = [
      ...prListResults,
      ...aprListResults,
      ...apfListResults,
      ...apsListResults,
      ...teListResults,
    ]

    const getListPaymentIds = mergePaymentResults.map((item: PaymentRequestSimple) => item.id)

    let selectedPaymentCode = []

    // Selected budgets
    if (parameter === PRTypes.APF || parameter === PRTypes.TE) {
      selectedPaymentCode = projectBudgets.flatMap((project) => {
        return project.activities.flatMap((activity) => {
          return activity.budgets
            .flatMap((budget) => {
              return budget.code
            })
            .flat()
        })
      })
    } else {
      selectedPaymentCode = projectBudgets.flatMap((project) => {
        return project.activities.flatMap((activity) => {
          return activity.budgets
            .filter((budget) => budget.is_checked)
            .flatMap((budget) => {
              return budget.code
            })
            .flat()
        })
      })
    }

    const paymentDetails = await Promise.all(
      getListPaymentIds.map(async (id: string) => {
        const paymentDetailRes = await paymentRequestApi.pRControllerGetDetailPaymentRequest(id)
        const paymentDetail = paymentDetailRes.data.data

        return paymentDetail.projects
          .map((project) =>
            project.activities.map((activity) =>
              activity.budgets.map((budget) => ({
                ...budget,
                paid_at: paymentDetail.paid_at,
                pr_number: paymentDetail.number,
              })),
            ),
          )
          .flat()
      }),
    )

    const flattenPaymentDetails = [].concat(...[].concat(...paymentDetails))

    const filterPaymentDetails = flattenPaymentDetails.filter((payment) =>
      selectedPaymentCode.includes(payment['code']),
    )

    const aprList = filterPaymentDetails.filter((item) => item.pr_number.includes('APR'))
    const apsList = filterPaymentDetails.filter((item) => item.pr_number.includes('APS'))
    const apfList = filterPaymentDetails.filter((item) => item.pr_number.includes('APF'))
    const teList = filterPaymentDetails.filter((item) => item.pr_number.includes('TE'))

    // Avoid create APR (again) if budget have an APR, if have no APS yet consider to create an APS, if has an APS consider to create PR
    if (aprList.length > 0 && parameter === PRTypes.APR) {
      if (apsList.length === 0) {
        aprList.map((payment) => {
          toast.warning(
            `This budget code ${payment.code.replace(
              /\.(\d+)$/,
              '-$1',
            )} already has an APR but has no APS yet, create APS instead.`,
            {
              icon: <AlertTriangleIcon className="h-5 w-5 stroke-warning-500" />,
              autoClose: 10000,
            },
          )
        })
        setLoadingButtonStatement((prev) => ({ ...prev, [parameter]: false }))
        return false
      } else {
        // Has APS
        aprList.map((payment) => {
          toast.warning(
            `This budget code ${payment.code.replace(
              /\.(\d+)$/,
              '-$1',
            )} already has an APR and APS, create PR instead.`,
            {
              icon: <AlertTriangleIcon className="h-5 w-5 stroke-warning-500" />,
              autoClose: 10000,
            },
          )
        })
        return false
      }
    }

    // Avoid create PR if user have APR and not finished yet until APS
    if (apsList.length !== aprList.length && parameter === PRTypes.PR) {
      aprList.map((payment) => {
        toast.warning(
          `This budget code ${payment.code.replace(
            /\.(\d+)$/,
            '-$1',
          )} has an APR, but has no APS yet. Create APS for it instead`,
          {
            icon: <AlertTriangleIcon className="h-5 w-5 stroke-warning-500" />,
            autoClose: 10000,
          },
        )
      })
      setLoadingButtonStatement((prev) => ({ ...prev, [parameter]: false }))
      return false
    }

    // Avoid create APF if in current RF (TR) has a APF (Only one APF allowed)
    if (apfList.length > 0 && parameter === PRTypes.APF) {
      toast.warning(
        `You have an APF at ${apfList[0].pr_number.toUpperCase()}, only one APF allowed in current Travel Request`,
        {
          icon: <AlertTriangleIcon className="h-5 w-5 stroke-warning-500" />,
          autoClose: 10000,
        },
      )
      setLoadingButtonStatement((prev) => ({ ...prev, [parameter]: false }))
      return false
    }

    // Avoid create TE if in current RF (TR) has a TE (Only one TE allowed)
    if (teList.length > 0 && parameter === PRTypes.TE) {
      toast.warning(
        `You have an TE at ${teList[0].pr_number.toUpperCase()}, only one TE allowed in current Travel Request`,
        {
          icon: <AlertTriangleIcon className="h-5 w-5 stroke-warning-500" />,
          autoClose: 10000,
        },
      )
      setLoadingButtonStatement((prev) => ({ ...prev, [parameter]: false }))
      return false
    }

    // Avoid create PR/APR with have another unfinished PR/APR in some budget code in current RF
    for (let index = 0; index < filterPaymentDetails.length; index++) {
      const payment = filterPaymentDetails[index]
      if (payment.paid_at === null && payment.pr_number.includes('APR')) {
        toast.error(
          `You have unfinished payment with current budget at payment code ${payment['pr_number'].toUpperCase()}`,
        )
        setLoadingButtonStatement((prev) => ({ ...prev, [parameter]: false }))
        return false
      }
    }

    switch (parameter) {
      case PRTypes.PR:
        handlePaymentRequest(PRTypes.PR)
        break
      case PRTypes.APR:
        handlePaymentRequest(PRTypes.APR)
        break
      case PRTypes.APF:
        handlePaymentRequest(PRTypes.APF)
        break
      case PRTypes.TE:
        handlePaymentRequest(PRTypes.TE)
        break
      default:
        break
    }
  }

