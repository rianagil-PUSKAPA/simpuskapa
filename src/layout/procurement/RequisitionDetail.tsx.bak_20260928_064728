              className="w-full justify-center"
              size="lg"
              onClick={hideCloseRfConfirmationModal}
            >
              Cancel
            </Button>
          </>,
          <>
            <Button
              type="button"
              btnType="normal"
              variant="error"
              className="w-full justify-center"
              size="lg"
              onClick={closeRfAction}
              isLoading={loadingButtonStatement.closeRF}
            >
              Close the RF
            </Button>
          </>,
        ]}
      >
        <div className="mt-1 text-sm text-gray-600">
          <ul className="flex list-disc flex-col gap-0.5 px-6">
            <li>Make sure no more Payment Request will be made from this Requisition Form.</li>
            <li>
              All the remaining RF will be transferred to the remaining budget in their respective budget needs item.
            </li>
            <li className="font-semibold underline">This action is irreversible</li>
          </ul>
        </div>
      </Modal>

      {/* Delete Modal */}
      <Modal
        icon={<AlertCircleIcon className="h-6 w-6 stroke-error-500" />}
        theme={theme.ERROR}
        modalTitle="Are you sure want to delete this RF?"
        modalDescription="When you delete it, there is no way to undo the action. Please make sure you are aware that it will happen."
        modalButtons={[
          <>
            <Button
              type="button"
              btnType="normal"
              variant="secondary-gray"
              className="w-full justify-center"
              size="lg"
              onClick={closeDeleteConfirmationModal}
            >
              Cancel
            </Button>
          </>,
          <>
            <Button
              type="button"
              btnType="normal"
              variant="error"
              className="w-full justify-center"
              size="lg"
              onClick={deletePayment}
              isLoading={loadingButtonStatement.deleteRf}
            >
              Yes, Sure
            </Button>
          </>,
        ]}
        stateModal={isOpenModal.deleteConfirmationModal}
        handleCloseModal={closeDeleteConfirmationModal}
      />
    </>
  )
}
