      const result = projectBudgets.map((project) => ({
        ...project,
        activities: project.activities?.map((activity) => ({
          ...activity,
          budgets: activity.budgets.map((budget) => {
            // ✅
            const totalNormalPayments =
              normalPaymentRequestExist.map(
                (innerbudget) => innerbudget.find((item) => budget.code === item.code)?.total_prs,
              )[0] || 0
            // ✅
            const totalPaymentFromAPS =
              advancePaymentStatementRequestExist.map(
                (innerbudget) => innerbudget.find((item) => budget.code === item.code)?.total_prs,
              )[0] || 0
            // ✅
            const pureAPR =
              advancePaymentRequestExist.map(
                (innerbudget) => innerbudget.find((item) => budget.code === item.code)?.advance_payment_total,
              )[0] || 0

            // ✅
            const totalAPF =
              advancePerdiemFeeExist.map(
                (innerbudget) => innerbudget.find((item) => budget.code === item.code)?.advance_payment_total,
              )[0] || 0
            // ✅
            const totalTravelExpense =
              travelExpenseExist.map(
                (innerbudget) => innerbudget.find((item) => budget.code === item.code)?.travel_expenses || 0,
              )[0] || 0

            const otherBudget =
              travelExpenseExist.map((innerbudget) =>
                innerbudget.find((item) => item.vendor_category === 'Other'),
              )[0] || 0

            if (otherBudget) {
              const dynamicOthersFromTravelExpense = budgetList.projects
                .flatMap((project) => project.activities.flatMap((activity) => activity.budgets))
                .filter(
                  (budget) =>
                    budget.vendor_category_information.name === 'Other' &&
                    budget.code === otherBudget.code &&
                    budget.id !== otherBudget.id,
                )
              travelOthers = dynamicOthersFromTravelExpense
            }
            const totalRealPRS =
              totalTravelExpense +
              (totalPaymentFromAPS ? totalPaymentFromAPS : pureAPR) +
              totalNormalPayments +
              totalAPF

            return {
              ...budget,
              advance_payment_total: 0,
              total_prs: totalRealPRS,
              // 0 or minus will be considered as totally paid (minus mean over budget)
              totally_paid: budget.qty * budget.pkg_qty * budget.unit_cost_value - totalRealPRS <= 0 ? true : false,
            }
          }),
        })),
      }))

      const code = travelOthers[0]?.code
      const [alphabet, firstIndexing] = code ? code.split('.') : []
      const finalCode = `${alphabet}.${firstIndexing}`

      const finalResultWithDynamicOthers = result.map((project) => {
        return {
          ...project,
          activities: project.activities.map((activity) => {
            if (activity.code === finalCode) {
              return {
                ...activity,
                budgets: [...activity.budgets, ...travelOthers],
              }
            } else {
              return activity
            }
          }),
        }
      })

      setProjectBudgetsModified(finalResultWithDynamicOthers)
    }

    if (projectBudgets?.length > 0) {
      exec()
    }
  }, [projectBudgets])

